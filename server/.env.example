# MongoDB Atlas connection string
MONGODB_URI=

# Server
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
BETTER_AUTH_URL=http://localhost:4000
BETTER_AUTH_SECRET=

# GitHub OAuth login (optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Dodo Payments one-time donations
# API key from Dodo dashboard > Developer > API
DODO_PAYMENTS_API_KEY=
# Product id of the Pay What You Want one-time product (e.g. pdt_xxxx)
DODO_DONATION_PRODUCT_ID=
# Webhook signing secret from Dodo dashboard > Developer > Webhooks
DODO_WEBHOOK_KEY=
# "test" uses test.dodopayments.com, anything else uses live.dodopayments.com
DODO_PAYMENTS_ENVIRONMENT=test
# Allowed donation range in minor units (cents). Defaults: 100 / 100000
DODO_DONATION_MIN_CENTS=100
DODO_DONATION_MAX_CENTS=100000

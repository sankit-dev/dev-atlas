# MongoDB Atlas connection string
MONGODB_URI=

# Server
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
BETTER_AUTH_URL=http://localhost:4000
BETTER_AUTH_SECRET=

# GitHub OAuth login (optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Dodo Payments one-time donations
# API key from Dodo dashboard > Developer > API
DODO_PAYMENTS_API_KEY=
# Product id of the Pay What You Want one-time product (e.g. pdt_xxxx)
DODO_DONATION_PRODUCT_ID=
# Webhook signing secret from Dodo dashboard > Developer > Webhooks
DODO_WEBHOOK_KEY=
# "test" uses test.dodopayments.com, anything else uses live.dodopayments.com
DODO_PAYMENTS_ENVIRONMENT=test
# Allowed donation range in minor units (cents). Defaults: 100 / 100000
DODO_DONATION_MIN_CENTS=100
DODO_DONATION_MAX_CENTS=100000

# Proxy hops in front of the app so req.ip is the real client IP (Render: 1)
TRUST_PROXY=1
# Rate-limit window, also the cooldown once a client is blocked (ms)
RATE_LIMIT_WINDOW_MS=60000
# Max requests per IP per window, for every client
GLOBAL_IP_RATE_LIMIT=10

# Countries with tighter limits (ISO 3166-1 alpha-2, comma-separated)
RESTRICTED_COUNTRIES=PK
# Max requests per IP per window from a restricted country
RESTRICTED_COUNTRY_IP_LIMIT=5
# Max requests per window from all clients in a restricted country combined
RESTRICTED_COUNTRY_TOTAL_LIMIT=10

# Countries to block entirely, e.g. "KP,IR". Empty = off.
BLOCKED_COUNTRIES=
# Optional: trust this header for the country (only if a proxy you control sets
# it, e.g. cf-ipcountry behind Cloudflare). Otherwise the IP is looked up locally.
GEO_COUNTRY_HEADER=
